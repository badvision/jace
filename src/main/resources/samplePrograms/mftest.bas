1   R = 0 : REM RESULT VAR - MUST BE FIRST VAR (at VARTAB)
2   VA = PEEK(105) + PEEK(106) * 256 : REM VARTAB ADDRESS
3   REM VA+2=EXP VA+3=M1 VA+4=M2 VA+5=M3 VA+6=M4
4   REM (negative: bit7 of M1 is set)
5   REM
6   REM VERIFY LAYOUT: SET R=7.0, CHECK VA+2..VA+6
7   REM 7.0 MBF: EXP=131($83) M1=224($E0) M2=0 M3=0 M4=0
8   REM ================================================
9   REM MFTEST.BAS - MegaFlash FPU Pass/Fail Test
10  REM Uses hardcoded MBF bytes (no FAC PEEKing).
11  REM Result POKEd into R via variable table (no FAC).
12  REM
13  REM MBF FORMAT (from fpu.c):
14  REM   EXP, M1(MSB,bit7=1), M2, M3, M4(LSB), SIGN
15  REM   EXP=0 means zero. Leading 1-bit explicit in M1.
16  REM
17  REM VERIFIED VALUES (EXP M1 M2 M3 M4):
18  REM   0.0: 0   0    0  0  0
19  REM   2.0: 130 128  0  0  0   ($82 $80)
20  REM   3.0: 130 192  0  0  0   ($82 $C0)
21  REM   4.0: 131 128  0  0  0   ($83 $80)
22  REM   7.0: 131 224  0  0  0   ($83 $E0)
23  REM  12.0: 132 192  0  0  0   ($84 $C0)
24  REM
25  REM SEND BUFFER (13 bytes, interleaved per fpu.c):
26  REM   S(0)=FSIGN S(1)=ASIGN
27  REM   S(2)=FM4   S(3)=AM4  (LSB mantissa)
28  REM   S(4)=FM3   S(5)=AM3
29  REM   S(6)=FM2   S(7)=AM2
30  REM   S(8)=FM1   S(9)=AM1  (MSB mantissa)
31  REM   S(10)=FE   S(11)=AE  (exponents)
32  REM   S(12)=FX               (FAC ext)
33  REM
34  REM RESULT (8 bytes): RB(0)=ERR RB(1)=SIGN
35  REM   RB(2)=M4(LSB) RB(3)=M3 RB(4)=M2 RB(5)=M1(MSB)
36  REM   RB(6)=EXP RB(7)=EXT
37  REM
38  REM COMMANDS (defines.inc):
39  REM   FADD=$30=48  FMUL=$31=49  FDIV=$32=50
40  REM   FSIN=$33=51  FSQR=$39=57
41  REM ================================================
42  REM
100 REM --- ARRAY ALLOCATION ---
101 DIM S(12)
102 DIM RB(7)
103 REM
104 TC = 0 : PC = 0 : TN = 0
105 REM
106 REM --- VERIFY VARIABLE TABLE LAYOUT ---
107 REM Set R=7 then PEEK VA+2..VA+6. Reset R=0 after.
108 R = 7
109 VE = PEEK(VA+2) : V1 = PEEK(VA+3) : V2 = PEEK(VA+4)
110 V3 = PEEK(VA+5) : V4 = PEEK(VA+6)
111 R = 0
112 REM
200 REM --- BANNER ---
201 PRINT "MEGAFLASH FPU PASS/FAIL TEST"
202 PRINT "============================="
203 PRINT
204 PRINT "VARTAB=";VA;" (";
205 HI = INT(VA / 256) : LO = VA - HI * 256
206 V = HI : GOSUB 9900 : V = LO : GOSUB 9900 : PRINT ")"
207 PRINT "LAYOUT CHECK (R=7): EXP=";VE;" M1=";V1;" M2=";V2;" M3=";V3;" M4=";V4
208 IF VE = 131 AND V1 = 96 THEN PRINT "LAYOUT: OK" : GOTO 215
209 PRINT "LAYOUT: UNEXPECTED - CHECK VARIABLE ORDER!"
215 PRINT
216 REM
220 REM --- DETECT MEGAFLASH ---
221 ID = PEEK(49347) : REM IDREG $C0C3 first read
222 I2 = PEEK(49347) : REM second read
223 IS = ID + I2
224 IF IS = 255 THEN PRINT "MEGAFLASH: DETECTED" : GOTO 235
225 PRINT "WARNING: MEGAFLASH NOT DETECTED (IDSUM=";IS;")"
226 PRINT "RESULTS MAY BE GARBAGE."
235 PRINT
236 REM
300 REM --- TEST 1: FADD 3+4=7 ---
301 REM FAC=3.0: EXP=$82=130 M1=$C0=192 M2=0 M3=0 M4=0 SIGN=0
302 FE=130:F1=192:F2=0:F3=0:F4=0:FS=0:FX=0
303 REM ARG=4.0: EXP=$83=131 M1=$80=128 M2=0 M3=0 M4=0 SIGN=0
304 AE=131:A1=128:A2=0:A3=0:A4=0:AS=0
305 REM EXPECTED=7.0: EXP=$83=131 M1=$E0=224 M2=0 M3=0 M4=0 SIGN=0
306 EE=131:E1=224:E2=0:E3=0:E4=0:ES=0
307 CM=48:TN=1 : GOSUB 8000 : REM FADD=$30=48
308 NM$ = "FADD 3+4=7" : GOSUB 9500
309 REM
400 REM --- TEST 2: FMUL 3*4=12 ---
401 REM FAC=3.0: EXP=$82=130 M1=$C0=192
402 FE=130:F1=192:F2=0:F3=0:F4=0:FS=0:FX=0
403 REM ARG=4.0: EXP=$83=131 M1=$80=128
404 AE=131:A1=128:A2=0:A3=0:A4=0:AS=0
405 REM EXPECTED=12.0: EXP=$84=132 M1=$C0=192 M2=0 M3=0 M4=0 SIGN=0
406 EE=132:E1=192:E2=0:E3=0:E4=0:ES=0
407 CM=49:TN=2 : GOSUB 8000 : REM FMUL=$31=49
408 NM$ = "FMUL 3*4=12" : GOSUB 9500
409 REM
500 REM --- TEST 3: FSQR(4)=2 (UNARY) ---
501 REM FAC=4.0: EXP=$83=131 M1=$80=128
502 FE=131:F1=128:F2=0:F3=0:F4=0:FS=0:FX=0
503 REM ARG=0 (unused for unary ops)
504 AE=0:A1=0:A2=0:A3=0:A4=0:AS=0
505 REM EXPECTED=2.0: EXP=$82=130 M1=$80=128 M2=0 M3=0 M4=0 SIGN=0
506 EE=130:E1=128:E2=0:E3=0:E4=0:ES=0
507 CM=57:TN=3 : GOSUB 8000 : REM FSQR=$39=57
508 NM$ = "FSQR(4)=2" : GOSUB 9500
509 REM
600 REM --- TEST 4: FSIN(0)=0 (UNARY) ---
601 REM FAC=0.0: all zeros
602 FE=0:F1=0:F2=0:F3=0:F4=0:FS=0:FX=0
603 REM ARG=0 (unused)
604 AE=0:A1=0:A2=0:A3=0:A4=0:AS=0
605 REM EXPECTED=0.0: all zeros
606 EE=0:E1=0:E2=0:E3=0:E4=0:ES=0
607 CM=51:TN=4 : GOSUB 8000 : REM FSIN=$33=51
608 NM$ = "FSIN(0)=0" : GOSUB 9500
609 REM
700 REM --- TEST 5: FDIV 12/4=3 ---
701 REM FAC=4.0 (divisor in FDIV: result = ARG/FAC)
702 FE=131:F1=128:F2=0:F3=0:F4=0:FS=0:FX=0
703 REM ARG=12.0: EXP=$84=132 M1=$C0=192
704 AE=132:A1=192:A2=0:A3=0:A4=0:AS=0
705 REM EXPECTED=3.0: EXP=$82=130 M1=$C0=192 M2=0 M3=0 M4=0 SIGN=0
706 EE=130:E1=192:E2=0:E3=0:E4=0:ES=0
707 CM=50:TN=5 : GOSUB 8000 : REM FDIV=$32=50
708 NM$ = "FDIV 12/4=3" : GOSUB 9500
709 REM
800 REM --- SHOW R (RESULT OF LAST TEST VIA POKE) ---
801 PRINT
802 PRINT "R (last result via VAR TABLE POKE) =";R
803 PRINT
804 REM
900 REM --- SUMMARY ---
901 PRINT "============================="
902 IF PC = TC THEN PRINT PC;" OF ";TC;" TESTS PASSED" : GOTO 920
903 PRINT PC;" OF ";TC;" TESTS PASSED - SEE FAILURES ABOVE"
920 END
921 REM
8000 REM ============================================
8001 REM SUBROUTINE: BUILD SEND BUFFER, ISSUE CMD,
8002 REM READ RESULT INTO RB(0..7), POKE INTO R.
8003 REM Inputs: FE,F1-4,FS,FX (FAC), AE,A1-4,AS (ARG)
8004 REM         CM = FPU command byte
8005 REM Outputs: RB(0..7) filled; R updated via VA
8006 REM ============================================
8010 POKE 49344,0 : REM CMD_RESETBOTHPTRS - clean param+data ptrs before FPU op
8011 S(0)=FS  : REM FAC SIGN
8012 S(1)=AS  : REM ARG SIGN
8013 S(2)=F4  : REM FAC M4 (LSB mantissa)
8014 S(3)=A4  : REM ARG M4
8015 S(4)=F3  : REM FAC M3
8016 S(5)=A3  : REM ARG M3
8017 S(6)=F2  : REM FAC M2
8018 S(7)=A2  : REM ARG M2
8019 S(8)=F1  : REM FAC M1 (MSB mantissa)
8020 S(9)=A1  : REM ARG M1
8021 S(10)=FE : REM FAC EXP
8022 S(11)=AE : REM ARG EXP
8023 S(12)=FX : REM FAC EXT
8030 REM Reset param buffer pointer (CMD $02=2)
8031 POKE 49344,2
8032 REM Send 13 interleaved bytes to PARAMREG ($C0C1=49345)
8033 FOR I=0 TO 12 : POKE 49345,S(I) : NEXT I
8040 REM Issue FPU command to CMDREG ($C0C0=49344)
8041 POKE 49344,CM
8050 REM Poll STATUSREG until BUSY (bit7) clears
8051 TM=60000
8052 ST=PEEK(49344)
8053 IF ST >= 128 THEN TM=TM-1 : IF TM > 0 THEN GOTO 8052
8060 REM Reset param ptr before reading result
8061 POKE 49344,2
8062 REM Read 8 result bytes from PARAMREG
8063 FOR I=0 TO 7 : RB(I)=PEEK(49345) : NEXT I
8070 REM
8071 REM POKE RESULT INTO R VIA VARIABLE TABLE (no FAC)
8072 REM VA+2=EXP, VA+3=M1(with sign in bit7), VA+4=M2
8073 REM VA+5=M3,  VA+6=M4(LSB)
8074 REM RB(6)=EXP  RB(5)=M1(MSB,bit7=1)  RB(4)=M2
8075 REM RB(3)=M3   RB(2)=M4(LSB)  RB(1)=SIGN(0=pos,128=neg)
8076 PM1 = RB(5) AND 127 : REM Clear bit7 (leading 1-bit), replace with sign
8077 IF RB(1) >= 128 THEN PM1 = PM1 OR 128 : REM Set bit7 if negative
8078 POKE VA+2, RB(6) : REM EXP
8079 POKE VA+3, PM1   : REM M1 with sign embedded in bit7
8080 POKE VA+4, RB(4) : REM M2
8081 POKE VA+5, RB(3) : REM M3
8082 POKE VA+6, RB(2) : REM M4 (LSB)
8090 RETURN
8091 REM
9500 REM ============================================
9501 REM SUBROUTINE: COMPARE RESULT AND PRINT PASS/FAIL
9502 REM Inputs: TN=test num, NM$=name, TM=poll remaining
9503 REM         EE=expected EXP, E1-4=expected mantissa
9504 REM         ES=expected SIGN (0=positive, 128=negative)
9505 REM RB mapping: RB(6)=EXP  RB(5)=M1  RB(4)=M2
9506 REM             RB(3)=M3   RB(2)=M4   RB(1)=SIGN  RB(0)=ERR
9507 REM ============================================
9510 TC = TC + 1
9515 REM Check timeout first
9516 IF TM = 0 THEN PRINT "TEST ";TN;": ";NM$;"  FAIL (TIMEOUT)" : GOTO 9599
9520 REM Check error code and compare all fields
9521 PF = 1
9522 IF RB(0) <> 0  THEN PF = 0
9523 IF RB(6) <> EE THEN PF = 0
9524 IF RB(5) <> E1 THEN PF = 0
9525 IF RB(4) <> E2 THEN PF = 0
9526 IF RB(3) <> E3 THEN PF = 0
9527 IF RB(2) <> E4 THEN PF = 0
9528 IF RB(1) <> ES THEN PF = 0
9530 IF PF = 1 THEN PC = PC + 1 : PRINT "TEST ";TN;": ";NM$;"  PASS" : RETURN
9540 REM --- FAIL: print details ---
9541 PRINT "TEST ";TN;": ";NM$;"  FAIL"
9542 IF RB(0) <> 0 THEN PRINT "  ERR: ";RB(0)
9550 PRINT "  EXP: EXP=";EE;" M1=";E1;" M2=";E2;" M3=";E3;" M4=";E4;" SIGN=";ES
9551 PRINT "  GOT: EXP=";RB(6);" M1=";RB(5);" M2=";RB(4);" M3=";RB(3);" M4=";RB(2);" SIGN=";RB(1)
9560 PRINT "  SENT:";
9561 FOR I=0 TO 12 : PRINT " "; : V=S(I) : GOSUB 9900 : NEXT I : PRINT
9599 RETURN
